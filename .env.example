# 正式初始化使用 scripts/setup.py --source ... --apply；勿提交 .env。
APP_MODE=production
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./data/review.db
DATA_DIR=./data/review_files
BOOTSTRAP_ADMINS=
LOCAL_AUTH_MODULE=local_adapters.login_adapter
LOCAL_REVIEW_MODULE=local_adapters.review_rules
CREDENTIAL_TTL_SECONDS=28800
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# MODEL 优先于 AI_MODEL；APPLY_TOKEN 由本地审查函数按需使用。
MODEL=
APPLY_TOKEN=
ATTACHMENT_HOSTS=
MAX_UPLOAD_MB=20
MAX_ITEMS=20000
